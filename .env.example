# Set these in Coolify's environment variables panel (not as a file on the server).

# Your public domain as configured in Coolify + Cloudflare
DOMAIN_URL=https://yourdomain.com

# Public API URL — on Coolify this is the same domain (Coolify routes /api/* to backend)
NEXT_PUBLIC_API_BASE_URL=https://yourdomain.com

# Strong database password — generate one with: openssl rand -base64 32
DB_PASSWORD=change-me-to-a-strong-password
